# Configurações do Banco de Dados Relacional
DATABASE_URL=postgresql://usuario:senha@localhost:5432/moda_db

# Chaves de API para Modelos de IA
# Obtenha sua chave gratuita em: https://aistudio.google.com/
GOOGLE_API_KEY=sua_chave_gemini_aqui
GEMINI_API_KEY=sua_chave_gemini_aqui

# Opcional caso utilize modelos OpenAI
OPENAI_API_KEY=sua_chave_openai_opcional

# Diretório de persistência do Banco Vetorial ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Ambiente de execução (development | production)
ENVIRONMENT=development
